# Loaded automatically by Expo when NODE_ENV=production, which `expo export` sets.
#
# Precedence (verified against the installed @expo/env build, not assumed):
#   .env.production.local > .env.local > .env.production > .env
# and a variable already present in the real process environment is NEVER overwritten by
# any of these files (@expo/env/build/index.js:400). So the value Vercel injects at build
# time wins over this file, and this file only acts as the committed default.
#
# Local development is unaffected: `expo start` runs with NODE_ENV=development, which does
# not load .env.production, so it keeps using .env (localhost:4000).
#
# Not a secret: every EXPO_PUBLIC_* value is inlined into the client bundle by design.
EXPO_PUBLIC_API_URL=https://b2b-idea-production-1d8e.up.railway.app
