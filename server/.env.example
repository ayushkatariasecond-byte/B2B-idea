# ── Local development (SQLite) ─────────────────────────────────────────────
# Copy this file to `.env`. These defaults run the app locally with no extra setup.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=4000

# ── Production (fill these in on your host; NEVER commit real values) ───────
# Everything below is OPTIONAL locally — each integration stays OFF until its
# variables are set, so local dev behaves exactly as before.

# NODE_ENV=production
# APP_WEB_URL=https://your-web-app.com      # used for links inside emails

# Postgres (Supabase). Switch prisma/schema.prisma `provider` to "postgresql" for prod.
# The verve-prod database + schema are already provisioned (see HANDOFF.md §Provisioned).
# DATABASE_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres"

# Error monitoring (Sentry). DSN is safe to expose; project "verve-api" already exists.
# SENTRY_DSN=

# Transactional email (SendGrid). Generate an API key in the SendGrid dashboard.
# Sender ayushkatariasecond@gmail.com is already verified.
# SENDGRID_API_KEY=
# EMAIL_FROM=ayushkatariasecond@gmail.com
# EMAIL_FROM_NAME=Verve

# Media storage (Supabase Storage). Create a public bucket, then set these.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role-key>
# SUPABASE_BUCKET=media
