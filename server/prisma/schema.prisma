generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String
  name                   String
  handle                 String   @unique
  category               String
  bio                    String   @default("")
  avatarUrl              String?
  coverUrl               String?
  verified               Boolean  @default(false)
  verificationRequested  Boolean  @default(false)
  emailVerified          Boolean  @default(false)
  suspended              Boolean  @default(false)
  expoPushToken          String?
  createdAt              DateTime @default(now())

  // Nibbler prototype: city-locked restaurant directory. `city` is required at the
  // signup-validation layer for every account (restaurant or plain viewer) — it's what
  // scopes a viewer's feed. `@default("")` only exists so this stays a safe additive
  // migration; no real row should ever keep the empty default past signup.
  //
  // `city` is deliberately RETAINED alongside the real coordinates below rather than
  // replaced by them, for two reasons: it's the human-readable label the UI shows
  // ("No restaurants in Austin yet"), and it's the fallback matching key whenever either
  // side of a match has no coordinates — someone who declines the GPS permission still
  // gets a working feed instead of an empty one. See utils/geo.ts for the match rule.
  city                   String   @default("")
  // Real device coordinates, captured via expo-location when the user grants permission.
  // Nullable on purpose: permission-denied is a first-class supported state, not an error,
  // and every pre-existing row (and every seeded demo account) legitimately has none.
  latitude               Float?
  longitude              Float?
  isRestaurant           Boolean  @default(false)
  website                String?
  cuisineId              String?
  cuisine                Cuisine? @relation(fields: [cuisineId], references: [id])
  // Deliberately a JSON blob, not a MenuItem table: the spec calls for a flat list with
  // no categories/sections, and a whole CRUD subsystem for that would be overkill for a
  // one-night prototype. Shape: { name: string; price: number; description?: string }[].
  menuItems              Json     @default("[]")

  posts           Post[]
  likes           Like[]
  comments        Comment[]
  following       Follow[]        @relation("Follower")
  followers       Follow[]        @relation("Followee")
  views           PostView[]
  sentMessages    Message[]
  threadsAsA      Thread[]        @relation("ThreadA")
  threadsAsB      Thread[]        @relation("ThreadB")
  members         BusinessMember[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActed    Notification[] @relation("NotificationActor")
  savedPosts      SavedPost[]
  blocksMade      Block[]         @relation("Blocker")
  blocksReceived  Block[]         @relation("Blocked")
  reportsFiled    Report[]
  stories         Story[]
  storyViews      StoryView[]
  promoCodes      PromoCode[]
  redemptions     Redemption[]
  linkClicks      LinkClick[]     @relation("LinkClickRestaurant")
  linkClicksMade  LinkClick[]     @relation("LinkClickViewer")

  @@index([isRestaurant, city])
  // Supports the feed's bounding-box prefilter (see routes/posts.ts): restaurants are
  // narrowed by isRestaurant + a lat/long range before any distance math runs.
  @@index([isRestaurant, latitude, longitude])
}

// Discount-code redemption tracking. One restaurant can issue multiple codes; a code is
// redeemed by entering it (no login required, e.g. at checkout in person), and each
// redemption is logged. Duplicate redemptions of the same code ARE allowed by design: a
// single code is meant to be shared across many customers (this isn't a one-time-use
// coupon per person), and since redemption doesn't require login there's no reliable
// identity to dedupe against anyway. `active` is the restaurant's only on/off switch —
// there's no separate expiry timestamp in this model.
model PromoCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  restaurantId        String
  restaurant          Business @relation(fields: [restaurantId], references: [id])
  discountDescription String
  createdAt           DateTime @default(now())
  active              Boolean  @default(true)

  redemptions Redemption[]

  @@index([restaurantId])
}

model Redemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  redeemedAt  DateTime  @default(now())
  userId      String?
  user        Business? @relation(fields: [userId], references: [id])

  @@index([promoCodeId])
}

// One tap of a restaurant's website / ordering link. This is the closest thing Nibbler has
// to a conversion signal — it's the moment a viewer leaves to actually order — so it's
// worth its own table rather than a counter column on Business: a raw count can't answer
// "when did they click" or "is this trending", and an atomic increment would throw away
// the timestamps a restaurant's stats view needs.
//
// `viewerId` is nullable by design, matching Redemption above: public restaurant profiles
// are viewable (and their links tappable) without an account, and dropping those clicks
// would undercount the exact traffic a restaurant most wants to see.
model LinkClick {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Business @relation("LinkClickRestaurant", fields: [restaurantId], references: [id])
  clickedAt    DateTime @default(now())
  viewerId     String?
  viewer       Business? @relation("LinkClickViewer", fields: [viewerId], references: [id])

  @@index([restaurantId, clickedAt])
}

// Fixed cuisine taxonomy — a lookup table, not free text, so filtering/search stays
// exact-match and cheap. One cuisine per restaurant (a single FK, not a join table like
// the agency-directory's Service/Industry), since a restaurant picks one primary type.
model Cuisine {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique

  businesses Business[]
}

model BusinessMember {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  email        String   @unique
  passwordHash String
  role         String   @default("editor") // "editor" (owner is the Business row itself)
  createdAt    DateTime @default(now())

  @@index([businessId])
}

model Post {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id])
  mediaUrl        String
  mediaType       String   // "image" | "video"
  thumbnailUrl    String?
  caption         String
  tag             String
  shareCount      Int      @default(0)
  status          String   @default("published") // "draft" | "scheduled" | "published"
  scheduledFor    DateTime?
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now())

  likes     Like[]
  comments  Comment[]
  views     PostView[]
  hashtags  PostHashtag[]
  savedBy   SavedPost[]

  @@index([businessId])
  @@index([tag])
  @@index([status])
  @@index([hidden])
}

model Story {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  mediaUrl   String
  mediaType  String   // "image" | "video"
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  views StoryView[]

  @@index([businessId])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id])
  viewerId String
  viewer   Business @relation(fields: [viewerId], references: [id])
  createdAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId])
}

model Hashtag {
  id    String @id @default(cuid())
  tag   String @unique

  posts PostHashtag[]
}

model PostHashtag {
  id        String  @id @default(cuid())
  postId    String
  post      Post    @relation(fields: [postId], references: [id])
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id])

  @@unique([postId, hashtagId])
  @@index([hashtagId])
}

model SavedPost {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([businessId, postId])
}

model Block {
  id         String   @id @default(cuid())
  blockerId  String
  blocker    Business @relation("Blocker", fields: [blockerId], references: [id])
  blockedId  String
  blocked    Business @relation("Blocked", fields: [blockedId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   Business @relation(fields: [reporterId], references: [id])
  targetType String   // "post" | "comment" | "business"
  targetId   String
  reason     String
  status     String   @default("open") // "open" | "resolved" | "dismissed"
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([status])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   Business @relation("NotificationRecipient", fields: [recipientId], references: [id])
  actorId     String?
  actor       Business? @relation("NotificationActor", fields: [actorId], references: [id])
  type        String   // "like" | "comment" | "follow" | "message"
  postId      String?
  threadId    String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@index([recipientId, read])
}

model Like {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([postId, businessId])
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  text       String
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())

  // A "reply" is a comment the author flagged as directed at the restaurant — a question
  // about hours, allergens, whether something's still on the menu — as opposed to a public
  // remark to the room. Deliberately a boolean on Comment rather than its own model: the
  // row shape is identical (post, author, text, moderation flag, timestamp), so a separate
  // table would duplicate the schema, the moderation/hide path, the delete cascades, and
  // the serializer, purely to encode one bit. It also stays honest about what this is —
  // a lightweight lane inside the existing comment thread, not a messaging system. If
  // replies ever need their own lifecycle (threading, read receipts, DM-style delivery),
  // that's the point to split them out, and this flag is what would be migrated from.
  //
  // NOTE: not a self-referencing parentId — this is a viewer→restaurant question about the
  // post, not a comment-on-a-comment. Nesting is explicitly out of scope.
  isReply    Boolean  @default(false)
  // Set by the post's owner once they've dealt with a reply, so the "open questions"
  // indicator can drop back to zero without deleting the conversation.
  answered   Boolean  @default(false)

  @@index([postId])
  // Backs the owner's "unanswered replies first" query without scanning every comment.
  @@index([postId, isReply, answered])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    Business @relation("Follower", fields: [followerId], references: [id])
  followeeId  String
  followee    Business @relation("Followee", fields: [followeeId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followeeId])
}

model PostView {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  viewerId   String?
  viewer     Business? @relation(fields: [viewerId], references: [id])
  createdAt  DateTime @default(now())

  @@index([postId])
  @@index([createdAt])
}

model Thread {
  id            String   @id @default(cuid())
  participantAId String
  participantA   Business @relation("ThreadA", fields: [participantAId], references: [id])
  participantBId String
  participantB   Business @relation("ThreadB", fields: [participantBId], references: [id])
  createdAt     DateTime @default(now())

  messages Message[]

  @@unique([participantAId, participantBId])
}

model Message {
  id         String   @id @default(cuid())
  threadId   String
  thread     Thread   @relation(fields: [threadId], references: [id])
  senderId   String
  sender     Business @relation(fields: [senderId], references: [id])
  text       String
  createdAt  DateTime @default(now())
  readAt     DateTime?

  @@index([threadId])
}
