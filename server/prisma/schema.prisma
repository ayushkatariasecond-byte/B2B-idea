generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String
  name                   String
  handle                 String   @unique
  category               String
  bio                    String   @default("")
  avatarUrl              String?
  coverUrl               String?
  verified               Boolean  @default(false)
  verificationRequested  Boolean  @default(false)
  emailVerified          Boolean  @default(false)
  suspended              Boolean  @default(false)
  expoPushToken          String?
  createdAt              DateTime @default(now())

  // Nibbler prototype: city-locked restaurant directory. `city` is required at the
  // signup-validation layer for every account (restaurant or plain viewer) — it's what
  // scopes a viewer's feed. `@default("")` only exists so this stays a safe additive
  // migration; no real row should ever keep the empty default past signup.
  city                   String   @default("")
  isRestaurant           Boolean  @default(false)
  website                String?
  cuisineId              String?
  cuisine                Cuisine? @relation(fields: [cuisineId], references: [id])
  // Deliberately a JSON blob, not a MenuItem table: the spec calls for a flat list with
  // no categories/sections, and a whole CRUD subsystem for that would be overkill for a
  // one-night prototype. Shape: { name: string; price: number; description?: string }[].
  menuItems              Json     @default("[]")

  posts           Post[]
  likes           Like[]
  comments        Comment[]
  following       Follow[]        @relation("Follower")
  followers       Follow[]        @relation("Followee")
  views           PostView[]
  sentMessages    Message[]
  threadsAsA      Thread[]        @relation("ThreadA")
  threadsAsB      Thread[]        @relation("ThreadB")
  members         BusinessMember[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActed    Notification[] @relation("NotificationActor")
  savedPosts      SavedPost[]
  blocksMade      Block[]         @relation("Blocker")
  blocksReceived  Block[]         @relation("Blocked")
  reportsFiled    Report[]
  stories         Story[]
  storyViews      StoryView[]

  @@index([isRestaurant, city])
}

// Fixed cuisine taxonomy — a lookup table, not free text, so filtering/search stays
// exact-match and cheap. One cuisine per restaurant (a single FK, not a join table like
// the agency-directory's Service/Industry), since a restaurant picks one primary type.
model Cuisine {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique

  businesses Business[]
}

model BusinessMember {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  email        String   @unique
  passwordHash String
  role         String   @default("editor") // "editor" (owner is the Business row itself)
  createdAt    DateTime @default(now())

  @@index([businessId])
}

model Post {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id])
  mediaUrl        String
  mediaType       String   // "image" | "video"
  thumbnailUrl    String?
  caption         String
  tag             String
  shareCount      Int      @default(0)
  status          String   @default("published") // "draft" | "scheduled" | "published"
  scheduledFor    DateTime?
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now())

  likes     Like[]
  comments  Comment[]
  views     PostView[]
  hashtags  PostHashtag[]
  savedBy   SavedPost[]

  @@index([businessId])
  @@index([tag])
  @@index([status])
  @@index([hidden])
}

model Story {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  mediaUrl   String
  mediaType  String   // "image" | "video"
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  views StoryView[]

  @@index([businessId])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id])
  viewerId String
  viewer   Business @relation(fields: [viewerId], references: [id])
  createdAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId])
}

model Hashtag {
  id    String @id @default(cuid())
  tag   String @unique

  posts PostHashtag[]
}

model PostHashtag {
  id        String  @id @default(cuid())
  postId    String
  post      Post    @relation(fields: [postId], references: [id])
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id])

  @@unique([postId, hashtagId])
  @@index([hashtagId])
}

model SavedPost {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([businessId, postId])
}

model Block {
  id         String   @id @default(cuid())
  blockerId  String
  blocker    Business @relation("Blocker", fields: [blockerId], references: [id])
  blockedId  String
  blocked    Business @relation("Blocked", fields: [blockedId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   Business @relation(fields: [reporterId], references: [id])
  targetType String   // "post" | "comment" | "business"
  targetId   String
  reason     String
  status     String   @default("open") // "open" | "resolved" | "dismissed"
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([status])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   Business @relation("NotificationRecipient", fields: [recipientId], references: [id])
  actorId     String?
  actor       Business? @relation("NotificationActor", fields: [actorId], references: [id])
  type        String   // "like" | "comment" | "follow" | "message"
  postId      String?
  threadId    String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@index([recipientId, read])
}

model Like {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([postId, businessId])
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  text       String
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    Business @relation("Follower", fields: [followerId], references: [id])
  followeeId  String
  followee    Business @relation("Followee", fields: [followeeId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followeeId])
}

model PostView {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  viewerId   String?
  viewer     Business? @relation(fields: [viewerId], references: [id])
  createdAt  DateTime @default(now())

  @@index([postId])
  @@index([createdAt])
}

model Thread {
  id            String   @id @default(cuid())
  participantAId String
  participantA   Business @relation("ThreadA", fields: [participantAId], references: [id])
  participantBId String
  participantB   Business @relation("ThreadB", fields: [participantBId], references: [id])
  createdAt     DateTime @default(now())

  messages Message[]

  @@unique([participantAId, participantBId])
}

model Message {
  id         String   @id @default(cuid())
  threadId   String
  thread     Thread   @relation(fields: [threadId], references: [id])
  senderId   String
  sender     Business @relation(fields: [senderId], references: [id])
  text       String
  createdAt  DateTime @default(now())
  readAt     DateTime?

  @@index([threadId])
}
