generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String
  name                   String
  handle                 String   @unique
  category               String
  bio                    String   @default("")
  avatarUrl              String?
  coverUrl               String?
  verified               Boolean  @default(false)
  verificationRequested  Boolean  @default(false)
  emailVerified          Boolean  @default(false)
  suspended              Boolean  @default(false)
  expoPushToken          String?
  createdAt              DateTime @default(now())

  // ── Agency directory profile fields (additive; `category`/`bio` above are untouched
  // and still used by the existing feed/discover code) ──────────────────────────────
  description        String   @default("") // long-form "About us", distinct from the shorter `bio`
  foundedYear        Int?
  teamSize           String?  // a label like "11-50", not a strict enum/table — see migration notes
  headquartersLocation String?
  website            String?
  minProjectBudget   Int?     // USD
  hourlyRateMin      Int?     // USD
  hourlyRateMax      Int?     // USD

  posts           Post[]
  likes           Like[]
  comments        Comment[]
  following       Follow[]        @relation("Follower")
  followers       Follow[]        @relation("Followee")
  views           PostView[]
  sentMessages    Message[]
  threadsAsA      Thread[]        @relation("ThreadA")
  threadsAsB      Thread[]        @relation("ThreadB")
  members         BusinessMember[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActed    Notification[] @relation("NotificationActor")
  savedPosts      SavedPost[]
  blocksMade      Block[]         @relation("Blocker")
  blocksReceived  Block[]         @relation("Blocked")
  reportsFiled    Report[]
  stories         Story[]
  storyViews      StoryView[]

  caseStudies       CaseStudy[]
  services          AgencyService[]
  industries        AgencyIndustry[]
  inquiriesReceived Inquiry[]
  reviewsReceived   Review[]
}

model BusinessMember {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  email        String   @unique
  passwordHash String
  role         String   @default("editor") // "editor" (owner is the Business row itself)
  createdAt    DateTime @default(now())

  @@index([businessId])
}

model Post {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id])
  mediaUrl        String
  mediaType       String   // "image" | "video"
  thumbnailUrl    String?
  caption         String
  tag             String
  shareCount      Int      @default(0)
  status          String   @default("published") // "draft" | "scheduled" | "published"
  scheduledFor    DateTime?
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now())

  likes     Like[]
  comments  Comment[]
  views     PostView[]
  hashtags  PostHashtag[]
  savedBy   SavedPost[]

  @@index([businessId])
  @@index([tag])
  @@index([status])
  @@index([hidden])
}

model Story {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  mediaUrl   String
  mediaType  String   // "image" | "video"
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  views StoryView[]

  @@index([businessId])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id])
  viewerId String
  viewer   Business @relation(fields: [viewerId], references: [id])
  createdAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId])
}

model Hashtag {
  id    String @id @default(cuid())
  tag   String @unique

  posts PostHashtag[]
}

model PostHashtag {
  id        String  @id @default(cuid())
  postId    String
  post      Post    @relation(fields: [postId], references: [id])
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id])

  @@unique([postId, hashtagId])
  @@index([hashtagId])
}

model SavedPost {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([businessId, postId])
}

model Block {
  id         String   @id @default(cuid())
  blockerId  String
  blocker    Business @relation("Blocker", fields: [blockerId], references: [id])
  blockedId  String
  blocked    Business @relation("Blocked", fields: [blockedId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   Business @relation(fields: [reporterId], references: [id])
  targetType String   // "post" | "comment" | "business"
  targetId   String
  reason     String
  status     String   @default("open") // "open" | "resolved" | "dismissed"
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([status])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   Business @relation("NotificationRecipient", fields: [recipientId], references: [id])
  actorId     String?
  actor       Business? @relation("NotificationActor", fields: [actorId], references: [id])
  type        String   // "like" | "comment" | "follow" | "message" | "inquiry"
  postId      String?
  threadId    String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@index([recipientId, read])
}

model Like {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([postId, businessId])
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  text       String
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    Business @relation("Follower", fields: [followerId], references: [id])
  followeeId  String
  followee    Business @relation("Followee", fields: [followeeId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followeeId])
}

model PostView {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id])
  viewerId   String?
  viewer     Business? @relation(fields: [viewerId], references: [id])
  createdAt  DateTime @default(now())

  @@index([postId])
  @@index([createdAt])
}

model Thread {
  id            String   @id @default(cuid())
  participantAId String
  participantA   Business @relation("ThreadA", fields: [participantAId], references: [id])
  participantBId String
  participantB   Business @relation("ThreadB", fields: [participantBId], references: [id])
  createdAt     DateTime @default(now())

  messages Message[]

  @@unique([participantAId, participantBId])
}

model Message {
  id         String   @id @default(cuid())
  threadId   String
  thread     Thread   @relation(fields: [threadId], references: [id])
  senderId   String
  sender     Business @relation(fields: [senderId], references: [id])
  text       String
  createdAt  DateTime @default(now())
  readAt     DateTime?

  @@index([threadId])
}

// ════════════════════════════════════════════════════════════════════════════════
// Directory pivot (Phase 1 — schema foundation). Purely additive: nothing above this
// line is touched, the existing feed/social models keep working exactly as before.
// ════════════════════════════════════════════════════════════════════════════════

model Service {
  id   String @id @default(cuid())
  name String
  slug String @unique

  agencies AgencyService[]
}

model Industry {
  id   String @id @default(cuid())
  name String
  slug String @unique

  agencies AgencyIndustry[]
}

model AgencyService {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Business @relation(fields: [agencyId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([agencyId, serviceId])
  @@index([serviceId])
}

model AgencyIndustry {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Business @relation(fields: [agencyId], references: [id])
  industryId String
  industry   Industry @relation(fields: [industryId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([agencyId, industryId])
  @@index([industryId])
}

model CaseStudy {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Business @relation(fields: [agencyId], references: [id])
  title      String
  clientName String?
  summary    String   @default("")
  status     String   @default("draft") // "draft" | "published"
  hidden     Boolean  @default(false) // moderation, same meaning as Post.hidden
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  media   CaseStudyMedia[]
  results CaseStudyResult[]
  reviews Review[]

  @@index([agencyId])
  @@index([status])
  @@index([hidden])
}

model CaseStudyMedia {
  id           String    @id @default(cuid())
  caseStudyId  String
  caseStudy    CaseStudy @relation(fields: [caseStudyId], references: [id])
  mediaUrl     String
  mediaType    String    // "image" | "video"
  thumbnailUrl String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([caseStudyId])
}

model CaseStudyResult {
  id          String    @id @default(cuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id])
  metricLabel String    // e.g. "Organic traffic"
  metricValue String    // kept as text, not a number — real results are often "+150%", "3x ROAS", "#1 ranking"
  sortOrder   Int       @default(0)

  @@index([caseStudyId])
}

model Inquiry {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Business @relation(fields: [agencyId], references: [id])
  buyerId   String?
  buyer     Buyer?   @relation(fields: [buyerId], references: [id])
  name      String
  email     String
  company   String?
  message   String
  budget    String?
  status    String   @default("new") // "new" | "contacted" | "closed"
  createdAt DateTime @default(now())

  @@index([agencyId])
  @@index([status])
}

/// Lightweight, optional, email-only buyer identity — no password. Created implicitly
/// whenever an inquiry comes in under a given email, or explicitly via POST /buyers.
model Buyer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  inquiries Inquiry[]
  reviews   Review[]
}

/// Schema only for now (per the deferred Reviews decision) — no routes yet. Requires a
/// Buyer (unlike Inquiry, where buyerId is optional) because an anonymous review is a
/// worthless/spammable trust signal; an inquiry doesn't carry the same stakes.
model Review {
  id          String     @id @default(cuid())
  agencyId    String
  agency      Business   @relation(fields: [agencyId], references: [id])
  buyerId     String
  buyer       Buyer      @relation(fields: [buyerId], references: [id])
  caseStudyId String?
  caseStudy   CaseStudy? @relation(fields: [caseStudyId], references: [id])
  rating      Int        // 1-5
  title       String?
  body        String
  status      String     @default("pending") // "pending" | "published" | "rejected"
  hidden      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([agencyId])
  @@index([status])
}
